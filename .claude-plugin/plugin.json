{
  "name": "psxdata",
  "version": "0.1.1",
  "description": "Pakistan Stock Exchange data for Claude: load PSX prices, screener, indices, sectors and more into a local DuckDB and query them with SQL.",
  "author": { "name": "Muhammad Tauha" },
  "homepage": "https://github.com/psxdata/psxdata-mcp",
  "repository": "https://github.com/psxdata/psxdata-mcp",
  "license": "MIT",
  "keywords": ["psx", "pakistan", "stocks", "kse100", "duckdb", "mcp"],
  "mcpServers": {
    "psxdata": {
      "command": "docker",
      "args": [
        "run", "-i", "--rm",
        "-v", "psxdata-cache:/home/app/.psxdata",
        "mtauha/psxdata-mcp:0.1.1"
      ]
    }
  }
}
