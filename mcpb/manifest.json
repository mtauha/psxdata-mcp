{
  "$schema": "https://raw.githubusercontent.com/anthropics/mcpb/main/schemas/mcpb-manifest-v0.4.schema.json",
  "manifest_version": "0.4",
  "name": "psxdata",
  "display_name": "PSX Data",
  "version": "0.1.3",
  "description": "Pakistan Stock Exchange data for Claude: load PSX prices, screener, indices, sectors and more into a local DuckDB and query them with SQL.",
  "author": { "name": "Muhammad Tauha" },
  "homepage": "https://github.com/psxdata/psxdata-mcp",
  "repository": { "type": "git", "url": "https://github.com/psxdata/psxdata-mcp" },
  "license": "MIT",
  "keywords": ["psx", "pakistan", "stocks", "kse100", "duckdb", "mcp"],
  "server": {
    "type": "uv",
    "entry_point": "src/psxdata_mcp/server.py",
    "mcp_config": {
      "command": "uv",
      "args": ["run", "--directory", "${__dirname}", "--locked", "--no-dev", "psxdata-mcp"]
    }
  },
  "compatibility": {
    "platforms": ["darwin", "linux", "win32"],
    "runtimes": { "python": ">=3.11" }
  }
}
